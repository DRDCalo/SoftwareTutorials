# Settings for the DD4hep geometry viewer (geoWebDisplay), see README.md.
#
# HttpPort    pins the web server to a fixed port, so the port-forwarding command
#             in the README stays the same every time.
# OnetimeKey  disables the single-use key ROOT normally appends to the viewer URL.
#             That key is only ever handed to a browser that ROOT launches itself,
#             so without it a manually typed address cannot work.
#
# While the viewer runs it is reachable by anyone else on the same machine. That is
# fine for a tutorial geometry; delete this file to restore ROOT's defaults.
WebGui.HttpPort: 8090
WebGui.OnetimeKey: no
